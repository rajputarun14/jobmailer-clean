# Copy this file to application.properties and set real secrets locally
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=${EMAIL_USERNAME}
spring.mail.password=${EMAIL_PASSWORD}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.debug=${MAIL_DEBUG:false}
spring.mail.properties.mail.smtp.ssl.trust=smtp.gmail.com
spring.mail.properties.mail.smtp.connectiontimeout=5000
spring.mail.properties.mail.smtp.timeout=5000
spring.datasource.url=${DATABASE_URL:jdbc:postgresql://localhost:5432/jobmailer}
spring.datasource.username=${DATABASE_USERNAME:jobmailer}
spring.datasource.password=${DATABASE_PASSWORD}
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.open-in-view=false
security.jwt.secret=${JWT_SECRET}
security.credentials.encryption-key=${CREDENTIAL_ENCRYPTION_KEY}
security.jwt.ttl-seconds=3600
security.rate-limit.max-requests=30
security.rate-limit.window-seconds=60
ai.provider=${AI_PROVIDER:gemini}
gemini.model=${GEMINI_MODEL:gemini-2.5-flash}
